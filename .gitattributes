# Normalize line endings in the repository; check out each file type with the EOL it needs.
* text=auto

# Windows batch files need CRLF, shell scripts must keep LF (a CR breaks the shebang line).
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# Binary files
*.png binary
*.wav binary
*.mp4 binary
*.flac binary
